<Window x:Class="MhsPipeline.App.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择文件夹" Height="440" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FF17191C" Foreground="#FFE6E8EA" FontSize="11">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF23262B"/>
            <Setter Property="Foreground" Value="#FFE6E8EA"/>
            <Setter Property="BorderBrush" Value="#FF32363C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2C3138"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF121417"/>
            <Setter Property="Foreground" Value="#FFE6E8EA"/>
            <Setter Property="BorderBrush" Value="#FF32363C"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF121417"/>
            <Setter Property="Foreground" Value="#FFE6E8EA"/>
            <Setter Property="BorderBrush" Value="#FF32363C"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 根位置（文件系统：驱动器 / 内容路径：工程 Content） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="RootLabel" Text="驱动器" VerticalAlignment="Center" Foreground="#FF9AA1A9" Width="58"/>
            <ComboBox x:Name="RootCombo" Width="240" SelectionChanged="OnRootChanged"/>
            <TextBlock x:Name="ModeHint" Text="" VerticalAlignment="Center" Foreground="#FF6E757D" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 当前路径（可直接编辑 + 回车跳转） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="路径" VerticalAlignment="Center" Foreground="#FF9AA1A9" Width="58"/>
            <TextBox x:Name="PathBox" Width="440" KeyDown="OnPathKeyDown"/>
            <Button Content="上一级" Click="OnUp"/>
        </StackPanel>

        <!-- 子文件夹列表 -->
        <ListBox Grid.Row="2" x:Name="DirList" MouseDoubleClick="OnDirDoubleClick"
                 SelectionChanged="OnDirSelectionChanged"/>

        <TextBlock Grid.Row="3" x:Name="ResultText" Text="" Margin="0,8,0,0" Foreground="#FF8FB8FF"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Click="OnOk" Background="#FF2E6FD6"/>
            <Button Content="取消" Click="OnCancel" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
