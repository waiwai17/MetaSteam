<Window x:Class="MhsPipeline.App.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建工程" Height="220" Width="480" Background="#FF0B0C0E" Foreground="#FFE8EBEE"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="工程名" Foreground="#FF5F666E" FontSize="11"/>
        <TextBox x:Name="NameBox" Height="28" Margin="0,4,0,12" Background="#FF0F1114" Foreground="#FFE8EBEE"
                 BorderBrush="#FF23262B" Padding="6,4" Text="MH_Line01"/>
        <TextBlock Text="位置" Foreground="#FF5F666E" FontSize="11"/>
        <TextBox x:Name="DirBox" Height="28" Margin="0,4,0,12" Background="#FF0F1114" Foreground="#FFE8EBEE"
                 BorderBrush="#FF23262B" Padding="6,4" Text="E:\Work\Mobu_maya\MetaSol\spike\projects"/>
        <TextBlock x:Name="HintText" Text="" Foreground="#FF5F666E" FontSize="10" Margin="0,0,0,10"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Width="80" Height="28" Margin="0,0,8,0" Background="#FF262A30" Foreground="#FFE8EBEE"
                    BorderBrush="#FF23262B" IsCancel="True"/>
            <Button Content="创建" Width="80" Height="28" Background="#FF2461B8" Foreground="White"
                    BorderBrush="#FF2461B8" IsDefault="True" Click="OnCreate"/>
        </StackPanel>
    </StackPanel>
</Window>
